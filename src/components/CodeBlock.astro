---
interface Props {
  code: string;
  language: string;
  filename?: string;
}
const { code, language, filename } = Astro.props;
---

<div class="astro-code" style="position:relative;">
  {filename && <p style="font-size:0.78rem;color:var(--ink-3);margin-bottom:0.5rem;font-style:italic;">{filename}</p>}
  <button class="code-copy-btn" type="button" aria-label="Copy code">Copy</button>
  <pre><code class:lang={language} set:html={code.trim()} /></pre>
</div>

<script>
  document.querySelectorAll('.astro-code .code-copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const pre = btn.parentElement?.querySelector('pre code');
      const text = pre?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = '✓ Copied!';
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      } catch {
        btn.textContent = 'Failed';
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      }
    });
  });
</script>